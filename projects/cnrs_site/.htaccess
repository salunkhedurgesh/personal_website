# Revalidate on normal visits and reloads, including URLs with a version query.
# Apache can return 304 for unchanged files instead of downloading them again.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/wasm .wasm
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml model/gltf-binary application/wasm
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate"
</IfModule>
